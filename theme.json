{
	"$schema": "https://schemas.wp.org/wp/6.8/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1200px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "base", "name": "Base", "color": "#FBFAF7" },
				{ "slug": "surface", "name": "Surface", "color": "#FFFFFF" },
				{ "slug": "contrast", "name": "Contrast", "color": "#14161A" },
				{ "slug": "muted", "name": "Muted", "color": "#5E6470" },
				{ "slug": "border", "name": "Border", "color": "#E6E3DC" },
				{ "slug": "accent", "name": "Accent", "color": "#3B5BFD" },
				{ "slug": "accent-soft", "name": "Accent soft", "color": "#ECEFFF" },
				{ "slug": "on-accent", "name": "On accent", "color": "#FFFFFF" }
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": ["px", "em", "rem", "%", "vh", "vw"],
			"spacingSizes": [
				{ "slug": "20", "name": "2X-Small", "size": "0.5rem" },
				{ "slug": "30", "name": "X-Small", "size": "0.75rem" },
				{ "slug": "40", "name": "Small", "size": "1rem" },
				{ "slug": "50", "name": "Medium", "size": "clamp(1.25rem, 2.5vw, 1.75rem)" },
				{ "slug": "60", "name": "Large", "size": "clamp(1.75rem, 4vw, 2.75rem)" },
				{ "slug": "70", "name": "X-Large", "size": "clamp(2.5rem, 6vw, 4.5rem)" },
				{ "slug": "80", "name": "2X-Large", "size": "clamp(3.5rem, 9vw, 7rem)" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "inter",
					"name": "Inter",
					"fontFamily": "Inter, ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Inter",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/inter-variable.woff2"]
						},
						{
							"fontFamily": "Inter",
							"fontStyle": "italic",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/inter-variable-italic.woff2"]
						}
					]
				},
				{
					"slug": "mono",
					"name": "Monospace",
					"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.875rem", "fluid": false },
				{ "slug": "medium", "name": "Medium", "size": "1.0625rem", "fluid": false },
				{ "slug": "large", "name": "Large", "size": "1.25rem", "fluid": { "min": "1.125rem", "max": "1.375rem" } },
				{ "slug": "x-large", "name": "Extra large", "size": "1.75rem", "fluid": { "min": "1.5rem", "max": "2rem" } },
				{ "slug": "xx-large", "name": "2X large", "size": "2.75rem", "fluid": { "min": "2rem", "max": "3rem" } },
				{ "slug": "display", "name": "Display", "size": "4.25rem", "fluid": { "min": "2.5rem", "max": "4.5rem" } }
			]
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{ "slug": "soft", "name": "Soft", "shadow": "0 1px 2px rgba(20,22,26,.04), 0 8px 24px rgba(20,22,26,.06)" },
				{ "slug": "lifted", "name": "Lifted", "shadow": "0 2px 4px rgba(20,22,26,.05), 0 20px 48px rgba(20,22,26,.12)" }
			]
		},
		"custom": {
			"radius": { "small": "8px", "medium": "14px", "large": "24px", "pill": "999px" },
			"transition": "180ms cubic-bezier(.2,.7,.3,1)"
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"left": "var(--wp--preset--spacing--50)",
				"right": "var(--wp--preset--spacing--50)"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--inter)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.65",
			"letterSpacing": "-0.005em"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontWeight": "650",
					"lineHeight": "1.12",
					"letterSpacing": "-0.025em"
				}
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h4": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
			"h5": { "typography": { "fontSize": "var(--wp--preset--font-size--medium)" } },
			"h6": { "typography": { "fontSize": "var(--wp--preset--font-size--small)" } },
			"link": {
				"color": { "text": "var(--wp--preset--color--accent)" },
				"typography": { "textDecoration": "underline" },
				":hover": { "typography": { "textDecoration": "none" } }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--contrast)",
					"text": "var(--wp--preset--color--base)"
				},
				"border": { "radius": "var(--wp--custom--radius--pill)" },
				"spacing": {
					"padding": { "top": "0.8rem", "bottom": "0.8rem", "left": "1.4rem", "right": "1.4rem" }
				},
				"typography": { "fontSize": "var(--wp--preset--font-size--small)", "fontWeight": "600" },
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent)",
						"text": "var(--wp--preset--color--on-accent)"
					}
				},
				":focus": {
					"outline": { "color": "var(--wp--preset--color--accent)", "offset": "3px", "style": "solid", "width": "2px" }
				}
			},
			"caption": {
				"color": { "text": "var(--wp--preset--color--muted)" },
				"typography": { "fontSize": "var(--wp--preset--font-size--small)" }
			}
		},
		"blocks": {
			"core/navigation": {
				"typography": { "fontSize": "var(--wp--preset--font-size--small)", "fontWeight": "500" },
				"elements": {
					"link": {
						"typography": { "textDecoration": "none" },
						":hover": { "typography": { "textDecoration": "underline" } }
					}
				}
			},
			"core/site-title": {
				"typography": { "fontSize": "var(--wp--preset--font-size--large)", "fontWeight": "700", "letterSpacing": "-0.03em" },
				"elements": {
					"link": {
						"color": { "text": "var(--wp--preset--color--contrast)" },
						"typography": { "textDecoration": "none" }
					}
				}
			},
			"core/post-title": {
				"elements": {
					"link": {
						"color": { "text": "var(--wp--preset--color--contrast)" },
						"typography": { "textDecoration": "none" },
						":hover": { "color": { "text": "var(--wp--preset--color--accent)" } }
					}
				}
			},
			"core/post-date": {
				"color": { "text": "var(--wp--preset--color--muted)" },
				"typography": { "fontSize": "var(--wp--preset--font-size--small)" }
			},
			"core/post-terms": {
				"typography": { "fontSize": "var(--wp--preset--font-size--small)", "fontWeight": "500" }
			},
			"core/separator": {
				"color": { "text": "var(--wp--preset--color--border)" },
				"border": { "width": "1px" }
			},
			"core/quote": {
				"border": { "color": "var(--wp--preset--color--accent)", "style": "solid", "width": "0 0 0 3px" },
				"spacing": { "padding": { "left": "1.25rem" } },
				"typography": { "fontSize": "var(--wp--preset--font-size--large)" }
			},
			"core/code": {
				"color": {
					"background": "var(--wp--preset--color--contrast)",
					"text": "var(--wp--preset--color--base)"
				},
				"border": { "radius": "var(--wp--custom--radius--medium)" },
				"spacing": { "padding": { "top": "1.25rem", "bottom": "1.25rem", "left": "1.25rem", "right": "1.25rem" } },
				"typography": { "fontFamily": "var(--wp--preset--font-family--mono)", "fontSize": "var(--wp--preset--font-size--small)" }
			},
			"core/image": {
				"border": { "radius": "var(--wp--custom--radius--medium)" }
			},
			"core/featured-image": {
				"border": { "radius": "var(--wp--custom--radius--medium)" }
			},
			"core/details": {
				"border": { "bottom": { "color": "var(--wp--preset--color--border)", "style": "solid", "width": "1px" } },
				"spacing": { "padding": { "top": "1.1rem", "bottom": "1.1rem" } }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "page-no-title", "title": "Page without title", "postTypes": ["page"] }
	]
}
